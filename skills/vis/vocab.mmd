  %% vis visual vocabulary: appended by build.mjs to every flowchart. Edit colours here only.
  classDef person fill:#e6e6e6,stroke:#666666,color:#111111
  classDef external fill:#f4f4f4,stroke:#8a8a8a,stroke-dasharray:5 4,color:#333333
  classDef entry fill:#dcefd8,stroke:#3a7d34,color:#111111
  classDef core fill:#fff6cc,stroke:#b58a00,color:#111111
  classDef worker fill:#fff6cc,stroke:#b58a00,color:#111111
  classDef store fill:#d6e6f7,stroke:#2b5d9b,color:#111111
  classDef queue fill:#e8dcf5,stroke:#6a3fa0,color:#111111
  classDef artifact fill:#fde3cc,stroke:#c2621a,color:#111111
  classDef major font-size:17px,stroke-width:3px,font-weight:600
  classDef normal font-size:13px,stroke-width:1.5px
  classDef minor font-size:11px,stroke-width:1px,color:#444444
  classDef repo fill:#fbfbfb,stroke:#333333,stroke-width:1.5px
  classDef column fill:#fafafa,stroke:#999999,stroke-width:1px
  classDef faded fill:#f7f7f7,stroke:#cfcfcf,color:#9a9a9a,stroke-dasharray:0
  classDef lit stroke-width:2.5px
